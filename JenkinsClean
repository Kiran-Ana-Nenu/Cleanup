pipeline {
    agent any

    environment {
        APPROVERS = "admins"
    }

    stages {

        stage('Admin Approval') {
            steps {
                script {
                    def paramText = params.collect { k, v -> "${k} = ${v}" }.join("\n")
                    input message: """Admin approval required.
📌 Job Parameters:
${paramText}""",
                    ok: 'Approve',
                    submitter: env.APPROVERS
                }
            }
        }

        stage('Workspace Cleanup') {
            steps {
                echo "Cleaning workspace..."
                cleanWs()
            }
        }

        stage('Trigger Downstream Job') {
            steps {
                echo "Triggering downstream job: DockerCleanup_Down"
                build job: 'DockerCleanup_Down', wait: true
            }
        }
    }
}
