pipeline {
    agent any

    parameters {
        string(name: 'PARAM1', defaultValue: 'DefaultValue', description: 'Custom parameter for Docker cleanup')
        booleanParam(name: 'FLAG', defaultValue: true, description: 'Full cleanup if true, partial cleanup if false')
    }

    stages {
        stage('Docker Cleanup') {
            steps {
                script {
                    echo "PARAM1: ${params.PARAM1}"
                    echo "FLAG (full cleanup?): ${params.FLAG}"

                    if (params.FLAG) {
                        echo "Performing FULL Docker cleanup..."

                        sh '''
                            set -e

                            echo "Stopping containers (if any)..."
                            docker ps -q | xargs -r docker stop

                            echo "Removing containers..."
                            docker ps -aq | xargs -r docker rm -f

                            echo "Removing unused networks..."
                            docker network prune -f

                            echo "Removing ALL images (including dangling)..."
                            docker images -aq | xargs -r docker rmi -f
                            docker images -f dangling=true -q | xargs -r docker rmi -f

                            echo "Removing ALL volumes..."
                            docker volume ls -q | xargs -r docker volume rm -f

                            echo "Final prune..."
                            docker system prune -a -f --volumes || true

                            echo "Full Docker cleanup completed."
                        '''
                    } else {
                        echo "Performing PARTIAL Docker cleanup (only dangling images and unused networks)..."

                        sh '''
                            set -e

                            echo "Removing dangling images..."
                            docker images -f dangling=true -q | xargs -r docker rmi -f

                            echo "Removing unused networks..."
                            docker network prune -f

                            echo "Docker partial cleanup completed."
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline finished."
        }
    }
}
